{
  "name": "secutils-webui",
  "private": true,
  "type": "module",
  "author": {
    "name": "Secutils.dev",
    "email": "dev@secutils.dev"
  },
  "version": "1.0.0-beta.2",
  "alias": {
    "process": "process/browser.js"
  },
  "targets": {
    "src": {
      "source": [
        "src/index.html",
        "src/favicon.ico",
        "src/tools/monaco/*"
      ],
      "distDir": "./dist",
      "engines": {
        "browsers": [
          "last 2 versions",
          "Firefox ESR",
          "not dead"
        ]
      }
    },
    "retrack": {
      "source": "./retrack/*.ts",
      "distDir": "./dist/retrack",
      "outputFormat": "esmodule",
      "sourceMap": false,
      "optimize": true,
      "engines": {
        "node": "22.x"
      }
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@elastic/datemath": "^5.0.3",
    "@elastic/eui": "^119.0.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@ory/kratos-client-fetch": "^26.2.0",
    "@peculiar/x509": "^1.14.3",
    "moment": "^2.30.1",
    "monaco-editor": "^0.56.0",
    "nanoid": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@elastic/eslint-plugin-eui": "^2.16.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@parcel/compressor-brotli": "^2.16.4",
    "@parcel/compressor-gzip": "^2.16.4",
    "@parcel/config-default": "^2.16.4",
    "@parcel/core": "^2.16.4",
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/reporter-bundle-buddy": "^2.16.4",
    "@parcel/transformer-image": "^2.16.4",
    "@parcel/transformer-js": "^2.16.4",
    "@parcel/transformer-raw": "^2.16.4",
    "@parcel/transformer-typescript-tsc": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "@parcel/validator-typescript": "^2.16.4",
    "@types/connect": "^3.4.38",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "buffer": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "http-proxy-middleware": "^3.0.7",
    "parcel": "^2.16.4",
    "playwright-core": "1.61.1",
    "prettier": "^3.9.6",
    "process": "^0.11.10",
    "svgo": "^4.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "url": "^0.11.4",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@lmdb/lmdb-linux-arm64": "^3.5.6",
    "@parcel/rust-linux-arm64-musl": "^2.16.4",
    "@parcel/watcher-linux-arm64-musl": "^2.6.0",
    "@parcel/watcher-linux-x64-glibc": "^2.6.0",
    "@swc/core-linux-arm64-musl": "^1.16.1",
    "lightningcss-linux-arm64-musl": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "overrides": {
    "typescript": "^5.9.3"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "scripts": {
    "build": "parcel build --no-source-maps",
    "watch": "parcel --port 7171",
    "perf": "parcel build --reporter @parcel/reporter-bundle-buddy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .parcel-cache",
    "analyze": "node scripts/analyze-bundle.ts",
    "build:analyze": "npm run clean && npm run build && npm run analyze",
    "report": "open scripts/bundle-report.html 2>/dev/null || xdg-open scripts/bundle-report.html 2>/dev/null || echo 'Open scripts/bundle-report.html in your browser'"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.33": true,
    "fsevents@2.3.3": true,
    "lmdb@2.8.5": true,
    "msgpackr-extract@3.0.3": true
  }
}
