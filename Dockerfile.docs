# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS builder
ARG SECUTILS_ENV="prod"
ENV SECUTILS_ENV=${SECUTILS_ENV}
WORKDIR /app

# Copy `package.json` file from the component, to just install dependencies.
COPY ["components/secutils-docs/*.json", "./"]
COPY ["components/secutils-docs/*.js", "./"]
RUN set -x && npm ci

# Now copy the rest of the component files and build it. `plugins/` holds the local `llms.txt` generator, which runs in
# Docusaurus' `postBuild`, and `check-llms` gates the image on that generator's output actually being clean markdown.
COPY ["components/secutils-docs/plugins", "./plugins"]
COPY ["components/secutils-docs/scripts", "./scripts"]
COPY ["components/secutils-docs/src", "./src"]
COPY ["components/secutils-docs/static", "./static"]
COPY ["components/secutils-docs/docs", "./docs"]
COPY ["components/secutils-docs/blog", "./blog"]
RUN set -x && npm run build && npm run check-llms

FROM nginxinc/nginx-unprivileged:1.31.6-alpine3.24-slim@sha256:1517d8c358e2e093957ebee087afa9eb19a32f5d7ecb711b7429e369cb998224
COPY --from=builder ["/app/build/", "/usr/share/nginx/html/docs"]
COPY ["components/secutils-docs/config/nginx.conf", "/etc/nginx/conf.d/default.conf"]
