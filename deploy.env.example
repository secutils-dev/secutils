# Copy to deploy.env and fill in. deploy.env is gitignored.

# Private Docker registry hostname (e.g., registry.example.com)
DEPLOY_REGISTRY=

# Platform for docker buildx (default: linux/arm64)
DEPLOY_PLATFORM=linux/arm64

# Tag used for the dev environment (default: latest)
DEPLOY_DEV_TAG=latest

# Tag used for the production environment (e.g., 1.0.0-beta.1)
DEPLOY_PROD_TAG=

# Tag for the Camoufox web scraper image, versioned independently (e.g., v142)
DEPLOY_CAMOUFOX_TAG=

# Build routing: auto uses DEPLOY_REMOTE_IMAGES. Override with local or remote.
DEPLOY_BUILD_ROUTE=auto
DEPLOY_REMOTE_IMAGES=retrack-web-scraper,retrack-web-scraper-camoufox

# Private SSH alias or user@host. Keep the actual address in deploy.env.
DEPLOY_REMOTE_HOST=
DEPLOY_REMOTE_DOCKER=sudo -n docker
DEPLOY_REMOTE_DIR=/home/ubuntu/secutils-build
DEPLOY_REMOTE_BUILDER=secutils-deploy
DEPLOY_REMOTE_MEMORY=2g
DEPLOY_REMOTE_CPU_QUOTA=100000
DEPLOY_REMOTE_MIN_FREE_GB=8
